extends SceneTree

## Headless logic tests for the client core.
## Run:  godot --headless --path client --import   (once, to build class cache)
##       godot --headless --path client -s res://tests/run_tests.gd
##
## Golden vectors were generated by the TypeScript mirror implementation
## (server/test/golden.ts) — these tests catch any client/server drift.

var _failures := 0
var _passes := 0

func _init() -> void:
	print("== Block Duel client tests ==")
	test_rng_golden()
	test_rng_ints()
	test_generator_golden()
	test_generator_determinism()
	test_shapes_catalog()
	test_board_place_and_clear()
	test_board_collision()
	test_board_game_over()
	test_scoring()
	test_controller_flow()
	test_bitmask()
	print("== %d passed, %d failed ==" % [_passes, _failures])
	quit(1 if _failures > 0 else 0)

# ---- harness ----

func ok(cond: bool, name: String) -> void:
	if cond:
		_passes += 1
	else:
		_failures += 1
		printerr("FAIL: ", name)

func eq(a, b, name: String) -> void:
	if str(a) == str(b):
		_passes += 1
	else:
		_failures += 1
		printerr("FAIL: %s\n  expected: %s\n  got:      %s" % [name, str(b), str(a)])

func approx(a: float, b: float, name: String, eps := 0.000001) -> void:
	ok(absf(a - b) < eps, "%s (|%.9f - %.9f|)" % [name, a, b])

# ---- tests ----

func test_rng_golden() -> void:
	# Floats generated by server Rng(482913) — must match exactly.
	var expected := [0.036796912318095565, 0.8229757314547896, 0.6929165113251656,
		0.4283378575928509, 0.8650462189689279, 0.9111787672154605,
		0.17464539571665227, 0.07062615780159831]
	var rng := BDRng.new(482913)
	for i in expected.size():
		approx(rng.next_float(), expected[i], "rng float %d" % i)

func test_rng_ints() -> void:
	var expected := [25, 7, 12, 21, 13, 9, 1, 19]
	var rng := BDRng.new(12345)
	for i in expected.size():
		eq(rng.next_int(26), expected[i], "rng int %d" % i)

func test_generator_golden() -> void:
	eq(_sets(482913, 5), [[0, 19, 15], [8, 20, 22], [3, 1, 19], [15, 25, 4], [3, 0, 20]], "golden sets 482913")
	eq(_sets(1, 3), [[14, 0, 11], [24, 24, 4], [13, 16, 8]], "golden sets 1")
	eq(_sets(777, 3), [[15, 0, 3], [2, 14, 7], [4, 17, 13]], "golden sets 777")

func _sets(seed: int, n: int) -> Array:
	var out := []
	for i in n:
		out.append(PieceGenerator.generate_set(seed, i))
	return out

func test_generator_determinism() -> void:
	for s in [5, 42, 999999]:
		for i in 6:
			eq(PieceGenerator.generate_set(s, i), PieceGenerator.generate_set(s, i), "determinism seed %d set %d" % [s, i])

func test_shapes_catalog() -> void:
	eq(BlockShapes.SHAPES.size(), 26, "shape count")
	eq(BlockShapes.SHAPE_WEIGHTS.size(), 26, "weight count")
	# all normalized to origin
	var all_normalized := true
	for s in BlockShapes.SHAPES:
		var min_x := 99
		var min_y := 99
		for c in s["cells"]:
			min_x = mini(min_x, c.x)
			min_y = mini(min_y, c.y)
		if min_x != 0 or min_y != 0:
			all_normalized = false
	ok(all_normalized, "shapes normalized")

func test_board_place_and_clear() -> void:
	var b := BoardState.new()
	var single := BlockShapes.cells(0)
	for x in 8:
		b.place(single, Vector2i(x, 0), 1)
	# row cleared
	var empty := true
	for x in 8:
		if b.get_cell(x, 0) != 0:
			empty = false
	ok(empty, "row cleared")

func test_board_collision() -> void:
	var b := BoardState.new()
	var sq := BlockShapes.cells(9) # square2
	ok(b.can_place(sq, Vector2i(0, 0)), "can place 2x2")
	b.place(sq, Vector2i(0, 0), 1)
	ok(not b.can_place(sq, Vector2i(0, 0)), "collision rejected")
	ok(not b.can_place(sq, Vector2i(7, 7)), "oob rejected")
	ok(b.can_place(sq, Vector2i(6, 6)), "edge ok")

func test_board_game_over() -> void:
	var b := BoardState.new()
	for i in 64:
		b.cells[i] = 1
	ok(not b.any_placement_for_shape(BlockShapes.cells(0)), "full board has no moves")
	ok(not b.any_placement_for_shapes([BlockShapes.cells(0), BlockShapes.cells(1)]), "no shape fits")

func test_scoring() -> void:
	var e := ScoringConfig.score_placement(4, 1, 0)
	eq(e["gained"], 14, "placement + line bonus")
	eq(e["combo"], 1, "combo starts")
	var e2 := ScoringConfig.score_placement(4, 1, 1)
	eq(e2["gained"], 24, "combo multiplier")
	var e3 := ScoringConfig.score_placement(4, 2, 2)
	eq(e3["gained"], 94, "double clear with x3 combo")
	var e0 := ScoringConfig.score_placement(3, 0, 4)
	eq(e0["combo"], 0, "combo reset")
	eq(e0["gained"], 3, "blocks only")

func test_controller_flow() -> void:
	var c := GameController.new(42)
	var set0 := c.current_set()
	eq(set0.size(), 3, "set has 3 pieces")
	# place all three shapes anywhere legal
	var placed := 0
	for slot in 3:
		var shape := c.slot_shape(slot)
		var done := false
		for y in 8:
			for x in 8:
				if not done and c.can_place(slot, Vector2i(x, y)):
					var r := c.place(slot, Vector2i(x, y))
					if r.get("ok"):
						done = true
						placed += 1
		ok(done, "piece %d placeable" % slot)
	eq(c.set_index, 1, "advanced to set 1")
	eq(c.used_slots, [false, false, false], "slots reset")
	ok(c.score > 0, "score accumulated")

func test_bitmask() -> void:
	var b := BoardState.new()
	b.cells[0] = 1
	b.cells[7] = 1
	b.cells[63] = 1
	var mask := b.to_bitmask()
	eq(mask[0], 129, "row0 bits")
	eq(mask[7], 128, "row7 bits")
	var b2 := BoardState.new()
	b2.from_bitmask(mask)
	ok(b2.get_cell(0, 0) == 1 and b2.get_cell(7, 0) == 1 and b2.get_cell(7, 7) == 1, "bitmask roundtrip")
